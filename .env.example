# 환경변수 예시. 값은 비워 둠 — 실제 값은 배포 환경 설정에만 넣고 저장소에 커밋하지 않음.

# --- 기존 ---
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
ADMIN_EMAIL=
RESEND_API_KEY=
MAIL_FROM=

# --- SBworks SSO 수신 (개발기획 §3.5) ---
# SBworks 주소. 기본 https://sbworks.bond
SBWORKS_SSO_ISSUER=https://sbworks.bond
# 서명 공개키(JWKS). 비우면 <ISSUER>/api/public/sso/jwks
SBWORKS_SSO_JWKS_URL=
# 토큰 aud 로 쓰는 앱 이름. 기본 nmsolution
SSO_APP_ID=nmsolution
# state·세션 쿠키 HMAC 비밀(32자 이상). 비어 있으면 SSO 가 꺼짐
SSO_STATE_SECRET=
# SSO 켜기(기본 1)
SSO_ENABLED=1
# 로그인 화면에 로컬 로그인(관리자 처음 만들기·/portal/login) 링크 보이기(기본 1, 전환 기간)
LOCAL_LOGIN_ENABLED=1

# --- 본사 요약 API (개발기획 §10.1) ---
# SBworks 와 같은 값(HMAC-SHA256). 비어 있으면 /api/hq/summary 는 503
HQ_SUMMARY_SECRET=
